# ===== Database =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=monitoring_rfq

EMAIL_NOTIFICATIONS_ENABLED=true

# ===== AKUN SISTEM (penjembatan notifikasi) - ISI SENDIRI =====
# Menjadi default host/port untuk 4 akun grup, dan dipakai sebagai pengirim
# cadangan jika akun sebuah grup belum diisi.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=system.rfq@example.com
SMTP_PASSWORD=ganti-dengan-password-akun-sistem
SMTP_FROM=system.rfq@example.com

# ===== 4 AKUN GRUP - ISI SENDIRI =====
# Satu akun email per grup. Jika user Marketing mengirim notifikasi, email
# keluar dari akun Marketing ke semua anggota grup tujuan (anggota = user yang
# register dengan role tersebut). HOST/PORT/STARTTLS boleh dikosongkan agar
# mengikuti akun sistem. Jika USER/PASSWORD kosong, grup memakai akun sistem.

# Marketing
GROUP_MARKETING_SMTP_HOST=smtp.example.com
GROUP_MARKETING_SMTP_PORT=587
GROUP_MARKETING_SMTP_STARTTLS=true
GROUP_MARKETING_SMTP_USER=marketing@example.com
GROUP_MARKETING_SMTP_PASSWORD=ganti-password-marketing
GROUP_MARKETING_SMTP_FROM=marketing@example.com

# Engineering
GROUP_ENGINEERING_SMTP_HOST=smtp.example.com
GROUP_ENGINEERING_SMTP_PORT=587
GROUP_ENGINEERING_SMTP_STARTTLS=true
GROUP_ENGINEERING_SMTP_USER=engineering@example.com
GROUP_ENGINEERING_SMTP_PASSWORD=ganti-password-engineering
GROUP_ENGINEERING_SMTP_FROM=engineering@example.com

# Purchasing
GROUP_PURCHASING_SMTP_HOST=smtp.example.com
GROUP_PURCHASING_SMTP_PORT=587
GROUP_PURCHASING_SMTP_STARTTLS=true
GROUP_PURCHASING_SMTP_USER=purchasing@example.com
GROUP_PURCHASING_SMTP_PASSWORD=ganti-password-purchasing
GROUP_PURCHASING_SMTP_FROM=purchasing@example.com

# Management
GROUP_MANAGEMENT_SMTP_HOST=smtp.example.com
GROUP_MANAGEMENT_SMTP_PORT=587
GROUP_MANAGEMENT_SMTP_STARTTLS=true
GROUP_MANAGEMENT_SMTP_USER=management@example.com
GROUP_MANAGEMENT_SMTP_PASSWORD=ganti-password-management
GROUP_MANAGEMENT_SMTP_FROM=management@example.com

# Anggota grup Management otomatis di-CC saat grup lain mengirim notifikasi
NOTIFY_MANAGEMENT_CC=true
